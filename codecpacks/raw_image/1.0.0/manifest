# raw_image codecpack (WP13) — migrated to the WP60 registry manifest
# format. DICOM/PNM/BMP/TIFF -> lossless JXL, bit-exact.
#
# The helper is stdlib-only python3; the heavy lifting is cjxl/djxl
# (depends). The blob splices the UNTOUCHED container bytes (everything
# before/after the pixel region) around a lossless JXL of the normalized
# pixels, so rebuild is byte-exact by construction (see raw_image.py).
name = raw_image
version = 1.0.0
pack_version = 1
min_read = 0.3.0
algo = 13
codec_id = INVFS_ALGO_RAWIMG
format_id = raw_image
family = raw_image
category = optional
priority = 50
type = codec
caps = wholefile|external
provides = raw_image
replaces =
conflicts =
dec_mem = 0
generation = 1
# `requires` is the engine's alias (parse_manifest -> def.requires, probed at
# src/codecs/codec.c:1036) and must name EXECUTABLES: the helper execs cjxl and
# djxl on the normalized pixels, so the pack is unusable without them. It read
# `family:raw_image` here, which is not a tool name -- pack_tool_resolvable()
# looks for a file by that name in $INVFS_TOOLS / /usr/lib/invfs/tools /
# <pack>/bin / PATH, never found one, and the pack stayed permanently
# UNAVAILABLE. The registry manager's `depends` list is the same two tools.
depends = cjxl,djxl
requires = cjxl,djxl
# DICM at offset 128 (DICOM), P5/P6 (PNM), BM (BMP), II2A/MM2A (TIFF)
sniff.magic = 4449434D
sniff.offset = 128
sniff.magic = 5035
sniff.magic = 5036
sniff.magic = 424D
sniff.magic = 49492A00
sniff.magic = 4D4D002A
sniff.ext = dcm,pgm,ppm,bmp,tif,tiff
encode = python3 {pack}/raw_image.py encode {in} {out}
decode = python3 {pack}/raw_image.py decode {in} {out}
estimate = python3 {pack}/raw_image.py estimate {in}
