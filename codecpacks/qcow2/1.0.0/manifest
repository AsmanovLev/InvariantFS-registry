# qcow2 codecpack (WP16a/WP16b) — migrated to the WP60 registry manifest
# format. QEMU qcow2 disk image decomposition.
#
# qcow2 v2/v3 images only, no backing file, no internal snapshots, no
# compressed clusters, no encryption, refcount_bits=16, no unknown
# incompatible feature bits. One member: idx 1 "diskimg" = the concatenated
# allocated-cluster guest data in L1/L2 (guest) table order — a raw disk
# image prefix, the input the rawdisk container pack decomposes further
# (nested containers). The recipe is every other byte of the file verbatim
# (header + extensions, L1/L2 tables, refcount table + blocks, free-cluster
# junk, trailing junk, in file order) prefixed by a small pack-owned layout
# table, so rebuild is bit-exact by construction, junk-in-a-hole included.
# See qcow2.c for the full format documentation + the validation list.
#
# The sniff keys on the u32 signature "QFI\xFB" at offset 0. The map command
# makes the pack SEEKABLE (CAP_SEEK): reads splice from the recipe + the
# member sibling and never exec the pack.
name = qcow2
version = 1.0.0
pack_version = 1
min_read = 0.3.0
algo = 22
codec_id = INVFS_ALGO_QCOW2
format_id = qcow2
family = container
category = primary
priority = 100
type = container
caps = container|external
provides = container:qcow2,container
replaces =
conflicts =
dec_mem = 0
generation = 1
sniff.offset = 0
sniff.magic = 514649FB
sniff.ext = qcow2
enumerate = bin/qcow2 enumerate {in} {out}
extract = bin/qcow2 extract {in} {idx} {out}
strip = bin/qcow2 strip {in} {out}
rebuild = bin/qcow2 rebuild {recipe} {dir} {out}
map = bin/qcow2 map {in} {out}
estimate = bin/qcow2 estimate {in}
