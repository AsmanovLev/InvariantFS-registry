{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AsmanovLev/InvariantFS-registry/schema/index.schema.json",
  "title": "InvariantFS codecpack registry index",
  "description": "Machine index generated by tools/gen-index.py. It is the only file invfs-pack needs over HTTPS; file:// installs read it too, plus the per-pack manifest/sha256.",
  "type": "object",
  "required": ["schema", "generated", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1, "description": "index.json format version." },
    "generated": { "type": "string", "description": "UTC ISO-8601 generation timestamp." },
    "tool": { "type": "string", "description": "Generator id/version." },
    "packs": {
      "type": "array",
      "items": { "$ref": "#/definitions/pack" }
    }
  },
  "definitions": {
    "pack": {
      "type": "object",
      "required": ["name", "version", "manifest", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "version": { "type": "string" },
        "pack_version": { "type": "integer" },
        "algo": { "type": "integer" },
        "codec_id": { "type": "string" },
        "format_id": { "type": "string" },
        "family": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "integer" },
        "type": { "type": "string" },
        "caps": { "type": "array", "items": { "type": "string" } },
        "provides": { "type": "array", "items": { "type": "string" } },
        "replaces": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "min_read": { "type": "string" },
        "depends": { "type": "array", "items": { "type": "string" } },
        "recommends": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "manifest": { "type": "string", "description": "Repo-relative path to the manifest." },
        "sha256": { "type": "string", "description": "Repo-relative path to the per-pack sha256 manifest." },
        "artifacts": {
          "type": "array",
          "description": "Built artifacts (populated by CI release builds).",
          "items": {
            "type": "object",
            "required": ["platform", "path", "sha256"],
            "properties": {
              "platform": { "type": "string" },
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
